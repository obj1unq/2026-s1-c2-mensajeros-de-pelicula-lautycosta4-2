import entregas.*
import destinos.* 
import mensajeros.*

describe "casos de prueba" {
  test "1. El paquete de George que no está pago no puede 
      ser llevado por Neo a la matrix." {
        entrega.mensajero(neo)
        entrega.destino(laMatrix)
        paquete.paqueteNoPago()

        assert.equals(false, entrega.puedeEntregar())
  }
  test "2. El paquete de George que sí está pago puede ser 
      llevado por Jean a la matrix."{
        entrega.mensajero(jean_gray)
        entrega.destino(laMatrix)
        paquete.paquetePago()

        assert.equals(true, entrega.puedeEntregar()) 
  }
  test "3. El paquete de George que sí está pago no puede 
      ser llevado por Sara (que pesa 70kg) a Brooklyn si es 
      que utiliza un camión con un acoplado."{
        entrega.mensajero(sara_connor)
        entrega.destino(puenteBrooklyn)
        paquete.paquetePago()
        sara_connor.pesoPropio(70)
        sara_connor.vehiculo(camion)
        camion.acoplados(1)

        assert.equals(false, entrega.puedeEntregar())
    }
  test "4. La entrega anterior puede hacerse si Sara 
      usa una moto."{
        entrega.mensajero(sara_connor)
        entrega.destino(puenteBrooklyn)
        paquete.paquetePago()
        sara_connor.pesoPropio(70)
        sara_connor.vehiculo(moto)

        assert.equals(true, entrega.puedeEntregar())
  }
}
  
  